{
  "images": {
    "sizes": [320, 480, 640, 800, 1200, 1600],
    "domains": ["images.mapaprop.app", "images.unsplash.com"],
    "minimumCacheTTL": 3600,
    "formats": ["image/webp"]
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/favicon.ico", "destination": "/favicon.png" },
    { "source": "/favicon.svg", "destination": "/favicon.png" }
  ],
  "redirects": [
    { "source": "/pagina/quienes-somos", "destination": "/#nosotros", "permanent": true },
    { "source": "/pagina/contacto",       "destination": "/#contacto", "permanent": true },
    { "source": "/pagina/(.*)",           "destination": "/",          "permanent": true },
    { "source": "/contacto",              "destination": "/#contacto", "permanent": true },
    { "source": "/buscar",                "destination": "/buscar/",   "permanent": true },
    { "source": "/propiedades/alquiler",  "destination": "/alquileres.html", "permanent": true },
    { "source": "/propiedades/(.*)",      "destination": "/ventas.html",     "permanent": true },
    { "source": "/mapa/",                 "destination": "/ventas.html", "permanent": true },
    { "source": "/mapa",                  "destination": "/ventas.html", "permanent": true },
    { "source": "/mapa-propiedades",      "destination": "/ventas.html", "permanent": true },
    { "source": "/destacados/",           "destination": "/ventas.html", "permanent": true },
    { "source": "/destacados",            "destination": "/ventas.html", "permanent": true },
    { "source": "/styles/(.*)",           "destination": "/",          "permanent": true },
    { "source": "/scripts/(.*)",          "destination": "/",          "permanent": true },
    { "source": "/p/:id",                 "destination": "/propiedad/:id", "permanent": true }
  ]
}
